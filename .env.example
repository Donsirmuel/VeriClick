# VeriClick Docker Compose environment.
# Copy this file to `.env` (repo root) and fill in real values, then run:
#   docker compose up -d --build
# `.env` is gitignored and never committed.

# --- Database ---
# PostgreSQL runs entirely inside the Docker stack (the "db" service). This URL
# is the ONLY database value needed: the app connects with it and the db
# container seeds its initial user/database from it on first start.
# Format: postgres://USER:PASSWORD@db:5432/DATABASE
# Password must not contain "@", "/", or ":" characters.
DATABASE_URL=postgres://vericlick:replace-me-with-a-strong-db-password@db:5432/vericlick

# --- Django ---
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-secret
ALLOWED_HOSTS=vendora.page,www.vendora.page
CORS_ALLOWED_ORIGINS=https://vendora.page,https://www.vendora.page
CSRF_TRUSTED_ORIGINS=https://vendora.page,https://www.vendora.page

# Public base URL used to build shareable tracking links.
PUBLIC_TRACKING_BASE_URL=https://vendora.page

# --- Google sign-in (blank disables it) ---
# Must match the frontend VITE_GOOGLE_CLIENT_ID below.
GOOGLE_CLIENT_ID=

# --- Transactional email (Resend) ---
# Get an API key at https://resend.com/api-keys. Leave blank to skip emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=VeriClick <noreply@vendora.page>
# Base URL used to build links in outgoing emails (must not be empty).
SITE_URL=https://vendora.page

# --- Frontend (inlined at build time) ---
VITE_API_BASE_URL=https://vendora.page/api
VITE_SITE_URL=https://vendora.page
VITE_GOOGLE_CLIENT_ID=

# --- TLS (Caddy / Let's Encrypt) ---
# Public hostname(s) served by the frontend container; Caddy auto-issues and
# renews HTTPS certificates for them. NOTE: space-separated (Caddy's site-block
# syntax), NOT comma-separated. Must match ALLOWED_HOSTS / the API origin.
#
# CUSTOM TRACKING DOMAINS (the core feature) do NOT belong here. A customer can
# point any domain at this server (CNAME go -> vendora.page for subdomains, or
# an A record at the VPS IP for apex domains) and it gets a certificate
# automatically. Caddy only mints certs for domains the app has marked
# registered + verified (backend /api/internal/tls-allowed/), so abuse is
# prevented and no redeploy is needed per customer.
SITE_ADDRESSES=vendora.page www.vendora.page