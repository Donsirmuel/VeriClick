# VeriClick Docker Compose environment.
# Copy this file to `.env` (repo root) and fill in real values, then run:
#   docker compose up -d --build
# `.env` is gitignored and never committed.

# --- Database ---
# PostgreSQL runs entirely inside the Docker stack (the "db" service). This URL
# is the ONLY database value needed: the app connects with it and the db
# container seeds its initial user/database from it on first start.
# Format: postgres://USER:PASSWORD@db:5432/DATABASE
# Password must not contain "@", "/", or ":" characters.
DATABASE_URL=postgres://vericlick:replace-me-with-a-strong-db-password@db:5432/vericlick

# --- Django ---
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-secret
ALLOWED_HOSTS=getvericlick.site,www.getvericlick.site
CORS_ALLOWED_ORIGINS=https://getvericlick.site,https://www.getvericlick.site
CSRF_TRUSTED_ORIGINS=https://getvericlick.site,https://www.getvericlick.site

# Public base URL used to build shareable tracking links.
PUBLIC_TRACKING_BASE_URL=https://getvericlick.site

# --- Google sign-in (blank disables it) ---
# Must match the frontend VITE_GOOGLE_CLIENT_ID below.
GOOGLE_CLIENT_ID=

# --- Transactional email (Resend) ---
# Get an API key at https://resend.com/api-keys. Leave blank to skip emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=VeriClick <noreply@getvericlick.site>
# Base URL used to build links in outgoing emails (must not be empty).
SITE_URL=https://getvericlick.site
# Comma-separated addresses notified on successful payments (owner + senior engineer).
PAYMENT_NOTIFY_EMAILS=support@getvericlick.site,getpulsecharts@gmail.com

# --- Bachs payments (https://docs.bachs.io) ---
# Sandbox first: sk_sandbox_ keys against https://sandbox-api.bachs.io (default).
# Going live = swap to sk_live_ + BACHS_BASE_URL=https://api.bachs.io.
# Paste each plan's recurring prod_ ID into the Plan admin
# (/admin/vericlick/plan/). Set the webhook endpoint to
# https://getvericlick.site/api/webhooks/bachs/ and copy its signing secret here.
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
# BACHS_BASE_URL=https://sandbox-api.bachs.io
# BACHS_WEBHOOK_TOLERANCE_SECONDS=300

# --- Frontend (inlined at build time) ---
VITE_API_BASE_URL=https://getvericlick.site/api
VITE_SITE_URL=https://getvericlick.site
VITE_GOOGLE_CLIENT_ID=
# Search console verification codes (blank until you set up indexing; see
# vericlick-frontend/.env.example for where to get them).
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_VERIFICATION=

# --- TLS (Caddy / Let's Encrypt) ---
# Public hostname(s) served by the frontend container; Caddy auto-issues and
# renews HTTPS certificates for them. NOTE: space-separated (Caddy's site-block
# syntax), NOT comma-separated. Must match ALLOWED_HOSTS / the API origin.
#
# CUSTOM TRACKING DOMAINS (the core feature) do NOT belong here. A customer can
# point any domain at this server (CNAME go -> getvericlick.site for subdomains, or
# an A record at the VPS IP for apex domains) and it gets a certificate
# automatically. Caddy only mints certs for domains the app has marked
# registered + verified (backend /api/internal/tls-allowed/), so abuse is
# prevented and no redeploy is needed per customer.
SITE_ADDRESSES=getvericlick.site www.getvericlick.site