# Backend API
BACKEND_URL=https://vericlick.site
EDGE_API_KEY=ek_your_key_here

# Redis
REDIS_URL=redis://redis:6379/0

# Sync intervals (seconds)
SYNC_INTERVAL=60
EVENT_BATCH_INTERVAL=60

# Edge proxy hostname
EDGE_HOSTNAME=edge.vericlick.cc

# Host the anti-bot script is served from. Keeping it off the app domain means a
# protected customer's page source never names vericlick.site. Point this
# hostname's DNS at this server (A record), then set
# SCRIPT_BASE_URL=https://cdn.vericlick.cc on the BACKEND so the snippet it
# hands out points here.
SCRIPT_HOSTNAME=cdn.vericlick.cc
# Where this host forwards to. Server-to-server, never seen by a visitor.
SCRIPT_ORIGIN=https://vericlick.site

# GeoIP (optional — path to GeoLite2-City.mmdb)
GEOIP2_DB=
