# VeriClick frontend + reverse proxy (Caddy).
#
# Product domain serves the SPA + API + shield endpoints.
# No customer domains, no on-demand TLS, no /r/* redirects.
# The script model means customers embed shield.js from their own domain.

{
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	order ja3_ja4 before reverse_proxy
}

# ---- Static product domain (SPA + API + admin) ----
{$SITE_ADDRESSES} {
	encode gzip

	# Layer 3: JA4 TLS fingerprinting — extract and forward to Django
	ja3_ja4

	# ---- Django routes proxied to the backend service ----
	handle /api/* {
		reverse_proxy backend:8000 {
			header_up X-JA4 {tls.ja4}
			header_up X-JA3 {tls.ja3}
		}
	}
	handle /admin/* {
		reverse_proxy backend:8000 {
			header_up X-JA4 {tls.ja4}
			header_up X-JA3 {tls.ja3}
		}
	}
	handle /static/* {
		reverse_proxy backend:8000
	}
	handle /robots.txt {
		reverse_proxy backend:8000
	}
	handle /sitemap.xml {
		reverse_proxy backend:8000
	}

	# ---- Built SPA with client-side routing fallback ----
	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}

# ---- Port 80: redirect to HTTPS, keeping ACME http-01 challenges working ----
:80 {
	redir https://{host}{uri} permanent
}
