# Dev-docker build tuning: keep network fan-out low and retries high so `npm install`
# does not die with npm's "Exit handler never called!" on small-memory builds.
maxsockets=5
fetch-retries=6
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-retry-factor=2
prefer-offline=false
fund=false
audit=false