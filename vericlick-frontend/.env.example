# VeriClick frontend environment for InterServer deployment.
# Copy this file to .env and adjust values for your host. .env is gitignored
# and never committed. Vite inlines these at build time (npm run build).

VITE_API_BASE_URL=https://vericlick.site/api
VITE_SITE_URL=https://vericlick.site
# Google OAuth web client ID. Must match the backend GOOGLE_CLIENT_ID. Create it
# in Google Cloud Console -> Credentials -> OAuth client ID (Web), and add the
# exact origin you run the app on (e.g. https://vericlick.site once deployed) as
# an Authorized JavaScript origin.
VITE_GOOGLE_CLIENT_ID=
# Search console verification (leave blank until you set up indexing):
# Google -> https://search.google.com/search-console, copy the "google-site-verification" value.
# Bing -> https://www.bing.com/webmasters, copy the "msvalidate.01" value.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_VERIFICATION=