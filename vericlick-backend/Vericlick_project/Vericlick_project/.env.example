# ─── VeriClick backend environment ──────────────────────────────────────────
# Copy to `.env` for local development:  cp .env.example .env
# For production, copy to `.env` on the host / inject via your PaaS and set
# every value explicitly. When DEBUG=False, SECRET_KEY and ALLOWED_HOSTS are
# REQUIRED — the app refuses to start without them.

# Development
DEBUG=True

# Production ONLY: set to False and provide a strong value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-in-production

# Development defaults (DEBUG=True). In production these MUST be explicit —
# e.g. ALLOWED_HOSTS=vericlick.io,www.vericlick.io,api.vericlick.io
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# CORS — the origins that may call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# CSRF — SPA origins, e.g. https://vericlick.io (usually same as CORS).
CSRF_TRUSTED_ORIGINS=

# Set True only when Django sits behind a trusted proxy that sets
# X-Forwarded-Proto (nginx, Cloudflare, Heroku/Railway/Fly edge, …).
TRUST_X_FORWARDED_PROTO=False

# Database — SQLite (dev) or PostgreSQL (production)
# SQLite:       DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL:   DATABASE_URL=postgres://user:password@host:5432/vericlick
DATABASE_URL=sqlite:///db.sqlite3

# Google OAuth client ID (optional for dev)
GOOGLE_CLIENT_ID=

# Real GeoIP database path (production). Enrich click locations with
# country/region/city. Install geoip2 + a GeoLite2-City.mmdb and point here.
# Leave empty to use the safe offline fallback (Localhost/Private/Unknown).
GEOIP2_DB=
