# VeriClick backend environment for production (InterServer VPS).
# Copy this file to .env and adjust values for your host. .env is gitignored
# and never committed.

# Production default. Only set True for a local dev server.
DEBUG=False

# Core Django settings
SECRET_KEY=replace-me-with-a-long-random-secret
ALLOWED_HOSTS=getvericlick.site,www.getvericlick.site

# Database (PostgreSQL on the VPS)
POSTGRES_DB=vericlick
POSTGRES_USER=vericlick
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Or a full connection string, if you prefer it
# DATABASE_URL=postgres://vericlick:replace-me@127.0.0.1:5432/vericlick

# Browser origins allowed to call the API (your production domains)
CORS_ALLOWED_ORIGINS=https://getvericlick.site,https://www.getvericlick.site
CSRF_TRUSTED_ORIGINS=https://getvericlick.site,https://www.getvericlick.site

# Public URLs used in shareable tracking links and SEO files
PUBLIC_TRACKING_BASE_URL=https://getvericlick.site

# Public IP Caddy listens on. When set, the backend uses it to decide whether a
# customer domain actually points at this server (A/CNAME records). When blank,
# the backend resolves PUBLIC_TRACKING_BASE_URL to find the addresses instead.
TRACKING_SERVER_IP=

# Required behind Nginx so redirects/SSL work
TRUST_X_FORWARDED_PROTO=True

# Optional GeoIP database path
# GEOIP2_DB=/opt/vericlick/GeoLite2-City.mmdb

# Google sign-in. The OAuth client ID (from Google Cloud Console). When set, the
# backend verifies the id_token audience against it. Leave blank to disable
# Google sign-in. The matching VITE_GOOGLE_CLIENT_ID must be set in the frontend.
GOOGLE_CLIENT_ID=

# Transactional email (Resend). Get an API key at https://resend.com/api-keys.
# Leave blank to send no emails (signup/reset/upgrade notifications are skipped).
RESEND_API_KEY=
RESEND_FROM_EMAIL=VeriClick <noreply@getvericlick.site>
SITE_URL=https://getvericlick.site
# Comma-separated addresses notified on successful payments (owner + senior engineer).
PAYMENT_NOTIFY_EMAILS=support@getvericlick.site,getpulsecharts@gmail.com

# Bachs payments (https://docs.bachs.io).
# Sandbox first: key starts with sk_sandbox_ and BACHS_BASE_URL defaults to
# https://sandbox-api.bachs.io. Going live = sk_live_ key + https://api.bachs.io.
# Create each plan's recurring product in Bachs and paste its prod_ ID into the
# Plan admin (/admin/vericlick/plan/) so checkout knows what to charge.
# BACHS_WEBHOOK_SECRET comes from the webhook endpoint in the Bachs Developer
# Portal; point it at https://getvericlick.site/api/webhooks/bachs/.
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
# BACHS_BASE_URL=https://sandbox-api.bachs.io
# BACHS_WEBHOOK_TOLERANCE_SECONDS=300

# Business toggles are ADMIN-managed, not env-based:
#   - beta free mode (free product, unlimited domains) and
#   - sign-ups open/closed
# live in the SiteConfig singleton at /admin/vericlick/siteconfig/ so you can
# flip them without editing .env or redeploying. Do NOT set a BETA_FREE_MODE
# env key — it is intentionally not read anymore.
